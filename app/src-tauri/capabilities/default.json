{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for the main UI webview only. The content webview gets nothing.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "dialog:default"
  ]
}
