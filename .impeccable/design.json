      "css": ".ds-top{display:flex;align-items:center;gap:26px;height:68px;font-family:var(--font-ui)}.ds-top a{color:var(--ink-muted);font-size:14px;font-weight:500;text-decoration:none}.ds-top a:hover,.ds-top a[aria-current=page]{color:var(--ink)}.ds-top .ds-wm{color:var(--ink);font-size:18px;font-weight:700;letter-spacing:-.01em}.ds-push{margin-left:auto}.ds-top a:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}"
