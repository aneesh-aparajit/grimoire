      "description": "A well trough holding keys; the pressed one rises.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Source</button><button aria-pressed=\"false\">Preview</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;background:var(--well);border-radius:7px}.ds-seg button{height:22px;padding:0 8px;border:1px solid transparent;border-radius:5px;background:transparent;color:var(--ink-muted);font:500 12px var(--font-ui);cursor:pointer}.ds-seg button:hover{color:var(--ink)}.ds-seg button[aria-pressed=true]{background:var(--raise);border-color:var(--rule-strong);box-shadow:0 1px 0 rgb(0 0 0 / 0.06);color:var(--ink)}.ds-seg button:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
