      "html": "<input class=\"ds-input\" placeholder=\"https://\" />",
      "css": ".ds-input{height:32px;padding:0 10px;border:1px solid var(--rule-strong);border-radius:6px;background:var(--raise);color:var(--ink);font:14px var(--font-ui)}.ds-input::placeholder{color:var(--ink-faint)}.ds-input:focus{outline:2px solid var(--focus);outline-offset:-1px;border-color:transparent}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
