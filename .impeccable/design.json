      "css": ".ds-tag{display:inline-flex;align-items:baseline;gap:6px;height:26px;padding:0 10px;border:1px solid transparent;border-radius:13px;background:var(--well);color:var(--ink-muted);font:500 12.5px/24px var(--font-ui);cursor:pointer}.ds-tag span{font:11px var(--font-mono);color:var(--ink-faint)}.ds-tag:hover{color:var(--ink);border-color:var(--rule-strong)}.ds-tag[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--panel)}.ds-tag[aria-pressed=true] span{color:inherit;opacity:.8}.ds-tag:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
