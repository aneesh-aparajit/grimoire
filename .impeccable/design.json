  "components": [
    {
      "name": "Key",
      "kind": "button",
      "refersTo": "button-key",
      "description": "The default text button: a soft physical key. Every text button in the top band.",
      "html": "<button class=\"ds-key\">Mark done</button>",
      "css": ".ds-key{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--rule-strong);border-radius:6px;background:var(--raise);color:var(--ink);box-shadow:0 1px 0 rgb(0 0 0 / 0.06);font:500 13px/1 var(--font-ui);cursor:pointer;transition:background-color 120ms cubic-bezier(0.16,1,0.3,1),transform 80ms cubic-bezier(0.16,1,0.3,1)}.ds-key:hover{background:color-mix(in oklab,var(--raise) 85%,var(--ink) 4%)}.ds-key:active{transform:translateY(1px);box-shadow:none}.ds-key:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Primary Key",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one orange key per view: Run, Add, Install.",
      "html": "<button class=\"ds-key-go\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>Run</button>",
      "css": ".ds-key-go{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--signal-edge);border-radius:6px;background:var(--signal);color:var(--signal-ink);box-shadow:0 1px 0 rgb(0 0 0 / 0.14);font:600 13px/1 var(--font-ui);cursor:pointer;transition:background-color 120ms cubic-bezier(0.16,1,0.3,1),transform 80ms cubic-bezier(0.16,1,0.3,1)}.ds-key-go:hover{background:var(--signal-hover)}.ds-key-go:active{transform:translateY(1px);box-shadow:none}.ds-key-go:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Ink Key",
      "kind": "button",
      "refersTo": "button-on",
      "description": "A pressed-in ink key for a secondary that still opens something.",
      "html": "<button class=\"ds-key-on\">Open study</button>",
      "css": ".ds-key-on{display:inline-flex;align-items:center;height:28px;padding:0 10px;border:1px solid var(--ink);border-radius:6px;background:var(--ink);color:var(--panel);box-shadow:0 1px 0 rgb(0 0 0 / 0.06);font:600 13px/1 var(--font-ui);cursor:pointer}.ds-key-on:hover{background:color-mix(in oklab,var(--ink) 88%,var(--panel))}.ds-key-on:active{transform:translateY(1px);box-shadow:none}.ds-key-on:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Ghost Tool",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Icon tools and pane toggles: flat until hovered or pressed.",
      "html": "<button class=\"ds-ghost\" aria-label=\"Toggle source pane\" aria-pressed=\"true\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M9 3v18\"/></svg></button>",
      "css": ".ds-ghost{display:inline-grid;place-items:center;width:28px;height:28px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--ink);cursor:pointer;transition:background-color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-ghost:hover,.ds-ghost[aria-pressed=true]{background:var(--select-soft)}.ds-ghost:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Status Light",
      "kind": "custom",
      "refersTo": "pass",
      "description": "A 7px lamp with a halo beside a plain word. Green passed, amber running (blinks), red failed.",
      "html": "<span class=\"ds-light ds-pass\">Exit 0</span> <span class=\"ds-light ds-live\">Running</span> <span class=\"ds-light ds-fail\">Failed</span>",
      "css": ".ds-light{display:inline-flex;align-items:center;gap:7px;margin-right:14px;font:600 12px var(--font-ui)}.ds-light::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 0 2px color-mix(in oklab,currentColor 18%,transparent)}.ds-pass{color:var(--pass)}.ds-fail{color:var(--fail)}.ds-live{color:var(--caution)}.ds-live::before{animation:ds-blink 1s steps(2,start) infinite}@keyframes ds-blink{50%{opacity:.25}}"
    },
    {
      "name": "Inset Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A panel set into the body: lighter grey, 8px, hairline ring, a 36px head with a label and a mono path.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-head\"><span class=\"ds-label\">Notes</span><span class=\"ds-path\">attention/<b>NOTES.md</b></span></header><p class=\"ds-body\">Divide by the square root of d so softmax doesn't saturate.</p></section>",
      "css": ".ds-panel{background:var(--panel);border-radius:8px;box-shadow:0 0 0 1px var(--rule);overflow:hidden;max-width:420px}.ds-head{display:flex;align-items:center;gap:8px;height:36px;padding:0 8px 0 14px;border-bottom:1px solid var(--rule)}.ds-label{font:600 10.5px var(--font-ui);letter-spacing:.06em;text-transform:uppercase;color:var(--ink-faint)}.ds-path{font:11.5px var(--font-mono);color:var(--ink-faint)}.ds-path b{color:var(--ink);font-weight:500}.ds-body{margin:0;padding:16px 20px;font:15.5px/1.7 var(--font-ui);color:var(--ink)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
